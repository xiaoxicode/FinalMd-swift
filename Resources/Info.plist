<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 名称默认值 = 英文。系统语言为中文时由 zh*.lproj/InfoPlist.strings 覆盖成「墨写」；
         其他语言（含英文与未支持的语言）回退到这里，即 FinalMd。 -->
    <key>CFBundleName</key>
    <string>FinalMd</string>
    <key>CFBundleDisplayName</key>
    <string>FinalMd</string>
    <key>CFBundleIdentifier</key>
    <string>cn.moxie.markdown</string>
    <key>CFBundleExecutable</key>
    <string>FinalMd</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.1</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSSupportsAutomaticTermination</key>
    <true/>
    <key>NSSupportsSuddenTermination</key>
    <false/>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 Cliff</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <!-- 回退语言必须是英文：ja/ko/fr/de/es 等界面语言由应用内 Localizer 提供，
         bundle 没有对应的 .lproj 时会回退到开发语言，从而显示 FinalMd。 -->
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>zh</string>
        <string>zh-Hans</string>
        <string>zh-Hant</string>
        <string>ja</string>
        <string>ko</string>
        <string>fr</string>
        <string>de</string>
        <string>es</string>
    </array>

    <!-- 关联 .md / .markdown，Finder 里双击可用 FinalMd / 墨写 打开 -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Markdown Document</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>net.daringfireball.markdown</string>
                <string>public.plain-text</string>
            </array>
        </dict>
    </array>

    <!-- 允许读取用户选中的文件（沙箱关闭时非必需，保留以备后续开启） -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
