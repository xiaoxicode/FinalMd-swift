<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 名称默认值 = 英文。系统语言为中文时由 zh*.lproj/InfoPlist.strings 覆盖成「墨写」；
         其他语言（含英文与未支持的语言）回退到这里，即 FinalMd。 -->
    <key>CFBundleName</key>
    <string>FinalMd</string>
    <key>CFBundleDisplayName</key>
    <string>FinalMd</string>
    <key>CFBundleIdentifier</key>
    <string>cn.moxie.markdown</string>
    <key>CFBundleExecutable</key>
    <string>FinalMd</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.1.0</string>
    <key>CFBundleVersion</key>
    <string>2</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- 关掉最后一个窗口后进程要留在 Dock 里（AppDelegate 已实现 reopen）。
         开着自动终止会让系统在无窗口时悄悄结束进程，未保存的文档会丢。 -->
    <key>NSSupportsAutomaticTermination</key>
    <false/>
    <key>NSSupportsSuddenTermination</key>
    <false/>
    <!-- 自定义大模型可能指向本机的 Ollama / LM Studio（http://127.0.0.1:...）。
         只放开本地网络，不开放任意 http，远端服务仍要求 https。 -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 Cliff</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <!-- 回退语言必须是英文：ja/ko/fr/de/es 等界面语言由应用内 Localizer 提供，
         bundle 没有对应的 .lproj 时会回退到开发语言，从而显示 FinalMd。 -->
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>zh</string>
        <string>zh-Hans</string>
        <string>zh-Hant</string>
        <string>ja</string>
        <string>ko</string>
        <string>fr</string>
        <string>de</string>
        <string>es</string>
    </array>

    <!-- 关联 .md / .markdown，Finder 里双击可用 FinalMd / 墨写 打开 -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Markdown Document</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>net.daringfireball.markdown</string>
                <string>public.plain-text</string>
            </array>
        </dict>
    </array>

    <!-- 权限声明在 Resources/FinalMd.entitlements，签名时由 codesign --entitlements 写入。
         Info.plist 里写 entitlement 键是无效的，别再往这里加。 -->
</dict>
</plist>
